# Server Configuration
NODE_ENV=production
PORT=3000
WEBRTC_PORT=3001
API_VERSION=v1
CORS_ORIGIN=https://nearchat.com

# Database Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/nearchat?retryWrites=true&w=majority
MONGODB_OPTIONS=retryWrites=true&w=majority&maxPoolSize=100&minPoolSize=5
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=secure_password_here

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=secure_redis_password
REDIS_CLUSTER_MODE=false
REDIS_CLUSTER_NODES=localhost:7000,localhost:7001,localhost:7002

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12
SESSION_SECRET=your_session_secret_here
COOKIE_SECRET=your_cookie_secret_here

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=https://api.nearchat.com/auth/google/callback

# WebRTC & Media
WEBRTC_ICE_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
MEDIASOUP_WORKER_BIN=/usr/local/bin/mediasoup-worker
MEDIASOUP_WORKER_LOGS=/var/log/mediasoup-worker
SCREEN_RECORDING_ENABLED=true
AUDIO_RECORDING_ENABLED=true
VIDEO_RECORDING_ENABLED=true

# File Storage
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=nearchat-uploads
GOOGLE_CLOUD_PROJECT_ID=your_project_id
GOOGLE_CLOUD_BUCKET=nearchat-uploads
UPLOAD_MAX_SIZE=100MB
ALLOWED_FILE_TYPES=image/*,video/*,audio/*,application/pdf

# Feature Flags
FEATURE_LOCATION_BASED_CHAT=true
FEATURE_AUDIO_CALLS=true
FEATURE_VIDEO_CALLS=true
FEATURE_SCREEN_SHARING=true
FEATURE_SCREEN_RECORDING=true
FEATURE_GROUP_CHATS=true
FEATURE_CHANNELS=true
FEATURE_BROADCASTS=true
FEATURE_ANONYMOUS_CHAT=false
FEATURE_AI_MODERATION=true
FEATURE_TRANSLATION=true
FEATURE_VOICE_MESSAGES=true
FEATURE_STORY_SHARING=true
FEATURE_EVENT_CREATION=true
FEATURE_LOCATION_HISTORY=true

# Admin Configuration
ADMIN_EMAIL=admin@nearchat.com
ADMIN_PASSWORD=secure_admin_password
SUPER_ADMIN_EMAIL=superadmin@nearchat.com
SUPER_ADMIN_PASSWORD=secure_super_admin_password

# Monitoring & Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log
WINSTON_LOG_LEVEL=info
SENTRY_DSN=your_sentry_dsn_here
NEW_RELIC_LICENSE_KEY=your_new_relic_key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@nearchat.com

# Push Notifications
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY_ID=your_private_key_id
FIREBASE_PRIVATE_KEY=your_private_key
FIREBASE_CLIENT_EMAIL=your_client_email
FIREBASE_CLIENT_ID=your_client_id

# Analytics & Tracking
GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID
MIXPANEL_TOKEN=your_mixpanel_token
AMPLITUDE_API_KEY=your_amplitude_key

# Third Party Services
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Development & Testing
DEBUG=false
TEST_DATABASE_URI=mongodb://localhost:27017/nearchat_test
TEST_REDIS_URL=redis://localhost:6379/1
COVERAGE_REPORTS=true